# ==============================================================================
# Trace Dispatch - Environment Configuration
# ==============================================================================

# Target live audio stream URL (HTTP MP3/AAC audio stream, Icecast, Broadcastify relay, etc.)
# Example public NOAA/ATC/Dispatch stream or custom MP3 test stream
STREAM_URL="https://icecast.broadcastify.com/YOUR_STREAM_KEY_OR_PUBLIC_FEED_URL"

# Supabase Project Credentials (from your Supabase Project Settings -> API)
# URL: https://<project-ref>.supabase.co
SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Service Role Key (recommended for backend daemon) or Anon Key
SUPABASE_KEY="your-supabase-service-role-or-anon-key"

# Audio Slicing & Voice Activity Detection (VAD) Settings
# Silence threshold in dBFS (decibels relative to full scale). 
# Audio louder than this is considered speech. Typical dispatch noise floor is -40 to -32.
SILENCE_THRESHOLD_DBFS=-36.0

# Duration of continuous silence (in seconds) required to close a transmission clip (e.g. 2.5s)
SILENCE_DURATION_SEC=2.5

# Rolling buffer of audio kept before speech detection (in seconds) to avoid clipping first word
PRE_ROLL_DURATION_SEC=0.8

# Minimum clip duration (in seconds) to ignore short static clicks / squelch bursts
MIN_CLIP_DURATION_SEC=1.2

# Maximum clip duration (in seconds) to prevent infinite recording on stuck open mics
MAX_CLIP_DURATION_SEC=90.0

# Optional: Groq API Key (Can also be entered in the web UI dashboard)
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"
